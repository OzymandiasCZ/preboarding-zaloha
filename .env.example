NEXT_PUBLIC_SUPABASE_URL=
# Anon/publishable klíč – jen pro přihlášení (session v cookies), smí být veřejný.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role klíč – jen na serveru, NIKDY s prefixem NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Allowlist (čárkou oddělené). Když není nastaveno ani jedno, nepustí se nikdo.
ALLOWED_EMAILS=user1@example.com,user2@example.com
ALLOWED_EMAIL_DOMAINS=example.com
# Volitelné: veřejná URL aplikace pro odkaz v e-mailu (jinak se použije Origin požadavku).
SITE_URL=https://preboarding.example.com
